{%- liquid
  assign icon_key = icon | default: 'fiber'
-%}
{%- case icon_key -%}
  {%- when 'temp' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 3h4v10.5a4 4 0 1 1-4 0V3Z" stroke="currentColor" stroke-width="1.6"/><path d="M10 7h4M10 10h4" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'air' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8h12a3 3 0 1 0-2.5-4M3 12h16a3 3 0 1 1-2.5 4M3 16h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'fiber' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3c4.5 6 6.5 8.8 6.5 12a6.5 6.5 0 1 1-13 0C5.5 11.8 7.5 9 12 3Z" stroke="currentColor" stroke-width="1.6"/><path d="M9.5 15.2c.6 2 2.2 3.1 4.2 3.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 20 6.5v6.2c0 5-3.6 8.2-8 9.3-4.4-1.1-8-4.3-8-9.3V6.5L12 3Z" stroke="currentColor" stroke-width="1.6"/><path d="m8.5 12.2 2.3 2.3 4.7-5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'usa' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.4" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M3 13h18M3 17h18M8.5 5v14" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.2 7-11.2a7 7 0 1 0-14 0C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.6" r="2.2" fill="currentColor"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.6 6.3 6.8.6-5.1 4.5 1.6 6.7L12 17.3 5.1 20.7l1.6-6.7L1.6 9.5l6.8-.6L12 2.6Z"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/></svg>
{%- endcase -%}
