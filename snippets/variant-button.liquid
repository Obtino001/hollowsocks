{%- assign swatch_file_extension = 'png' -%}

{%- capture size_chart_title -%}
  OPEN SIZE CHART
{%- endcapture -%}

{%- liquid
  assign is_size = false
  assign is_fit = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger or downcased_option contains 'size'
    assign is_size = true
  endif
  if downcased_option contains 'fit'
    assign is_fit = true
  endif

  assign size_range_label = ''
  assign selected_down = option.selected_value | downcase
  if selected_down == 'm' or selected_down == 'medium'
    assign size_range_label = 'MEN 6-9, WOMEN 7-9.5'
  elsif selected_down == 'l' or selected_down == 'large'
    assign size_range_label = 'MEN 9.5-12, WOMEN 10-13'
  elsif selected_down == 'xl' or selected_down == 'x-large' or selected_down == 'x large' or selected_down == 'extra large'
    assign size_range_label = 'MEN 12.5-15'
  elsif selected_down == 's' or selected_down == 'small'
    assign size_range_label = 'WOMEN 4-6.5'
  endif
-%}

<div class="variant-wrapper js{% if is_size %} hollow-variant--size{% endif %}{% if is_fit %} hollow-variant--fit{% endif %}" data-type="button">
  <div class="hollow-variant-label variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}">
    <div class="hollow-variant-label__left">
      {%- if is_size -%}
        <span class="hollow-variant-label__key" data-hollow-size-selected>{{ option.selected_value | upcase }}</span>{%- if size_range_label != blank -%}<span class="hollow-variant-label__sep">:</span> <span class="hollow-variant-label__range" data-hollow-size-range>{{ size_range_label }}</span>{%- endif -%}
      {%- elsif is_fit -%}
        <span class="hollow-variant-label__key">{{ option.name | upcase }}:</span>
        <span class="hollow-variant-label__value" data-hollow-fit-selected>{{ option.selected_value | upcase }}</span>
      {%- else -%}
        {{ option.name }}
        {%- if is_color -%}
          <span class="variant__label-info">
            &mdash;
            <span data-variant-color-label data-index="{{ forloop.index0 }}" data-option-index="{{ color_option_index }}">
              {{ option.selected_value }}
            </span>
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="hollow-variant-label__right">
      {%- if connect_to_sizechart and is_size -%}
        <a href="#HollowSizeChart" class="hollow-variant-label__link">OPEN SIZE CHART</a>
      {%- elsif is_size -%}
        <a href="#HollowSizeChart" class="hollow-variant-label__link">OPEN SIZE CHART</a>
      {%- elsif is_fit -%}
        <button type="button" class="hollow-variant-label__link" data-hollow-fit-details>OPEN FIT DETAILS</button>
      {%- endif -%}
    </div>
  </div>

  {%- assign option_index = forloop.index -%}
  <fieldset class="variant-input-wrap"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <legend class="hide">{{ option.name }}</legend>
    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1 and block.settings.product_dynamic_variants_enable
          assign product_available = product.variants[forloop.index0].available
        endif
        assign value_down = value | downcase
        assign short_size = value
        if value_down == 'medium'
          assign short_size = 'M'
        elsif value_down == 'large'
          assign short_size = 'L'
        elsif value_down == 'small'
          assign short_size = 'S'
        elsif value_down == 'x-large' or value_down == 'x large' or value_down == 'extra large'
          assign short_size = 'XL'
        endif
      -%}
      <div
        class="variant-input"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">
        <input type="radio"
          form="{{ form_id }}"
          {% if option.selected_value == value %} checked="checked"{% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">
        {%- if is_color -%}
          {%- if value.swatch -%}
            {%- liquid
              assign color_image = value.swatch.image | image_url: width: 50
              assign color_swatch_fallback = value.swatch.color
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if value.swatch.image %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- else -%}
            {%- liquid
              assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
              assign color_swatch_fallback = value | split: ' ' | last | handle
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- endif -%}
        {%- elsif is_fit -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label hollow-fit-label{% unless product_available %} disabled{% endunless %}">
            <span class="hollow-fit-label__icon" aria-hidden="true">
              {%- if value_down contains 'over' or value_down contains 'calf' or value_down contains 'otc' -%}
                <svg viewBox="0 0 40 56" fill="none"><path d="M14 4h12v28c0 2 .8 3.5 2.2 4.8L34 44c2 2 2 5.2 0 7.2s-5.2 2-7.2 0l-8.8-8.8C16.2 40.6 15 38.4 15 36V4Z" stroke="currentColor" stroke-width="2"/><path d="M14 12h12" stroke="currentColor" stroke-width="2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 40 48" fill="none"><path d="M14 4h12v20c0 1.8.7 3.2 2 4.4L32 36c1.6 1.6 1.6 4.2 0 5.8s-4.2 1.6-5.8 0l-7-7C17.6 33.2 16.5 31.4 16.5 29.4V4Z" stroke="currentColor" stroke-width="2"/><path d="M14 11h12" stroke="currentColor" stroke-width="2"/></svg>
              {%- endif -%}
            </span>
            <span class="hollow-fit-label__name">{{ value | escape }}</span>
          </label>
        {%- elsif is_size -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label hollow-size-label{% unless product_available %} disabled{% endunless %}"
            data-size-key="{{ short_size | upcase }}"
            data-size-range="{%- if value_down == 'm' or value_down == 'medium' -%}MEN 6-9, WOMEN 7-9.5{%- elsif value_down == 'l' or value_down == 'large' -%}MEN 9.5-12, WOMEN 10-13{%- elsif value_down == 'xl' or value_down == 'x-large' or value_down == 'x large' or value_down == 'extra large' -%}MEN 12.5-15{%- elsif value_down == 's' or value_down == 'small' -%}WOMEN 4-6.5{%- endif -%}">
            <span class="hollow-size-label__name">{{ short_size | upcase }}</span>
          </label>
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}">
            {{ value | escape }}
          </label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
