<section class="hollow-offers" aria-label="Mængderabat">
  {%- if section.settings.hollow_offers_label != blank -%}
    <p class="hollow-offers__label">{{ section.settings.hollow_offers_label | escape }}</p>
  {%- endif -%}
  {%- if section.settings.hollow_offers_subtitle != blank -%}
    <p class="hollow-offers__subtitle">{{ section.settings.hollow_offers_subtitle | escape }}</p>
  {%- endif -%}

  <div class="hollow-offers__card">
    <div class="hollow-offers__body">
      <div class="hollow-offers__left">
        <span class="hollow-offers__name">1 PAR</span>
        <span class="hollow-offers__each">299,00 KR/PAR + 39,00 KR I FRAGT</span>
      </div>
      <div class="hollow-offers__right">
        <span class="hollow-offers__price">299,00 KR</span>
      </div>
    </div>
  </div>

  <div class="hollow-offers__card">
    <span class="hollow-offers__badge">MEST POPULÆRE</span>
    <div class="hollow-offers__body">
      <div class="hollow-offers__left">
        <span class="hollow-offers__name">KØB 2, FÅ 2 GRATIS</span>
        <span class="hollow-offers__each">150,00 KR/PAR + FRI FRAGT</span>
      </div>
      <div class="hollow-offers__right">
        <span class="hollow-offers__price">599,00 KR</span>
        <s class="hollow-offers__was">1.196,00 KR</s>
      </div>
    </div>
  </div>

  <div class="hollow-offers__card">
    <span class="hollow-offers__badge hollow-offers__badge--value">BEDSTE VÆRDI</span>
    <div class="hollow-offers__body">
      <div class="hollow-offers__left">
        <span class="hollow-offers__name">KØB 3, FÅ 3 GRATIS</span>
        <span class="hollow-offers__each">150,00 KR/PAR + FRI FRAGT</span>
      </div>
      <div class="hollow-offers__right">
        <span class="hollow-offers__price">899,00 KR</span>
        <s class="hollow-offers__was">1.794,00 KR</s>
      </div>
    </div>
  </div>
</section>
