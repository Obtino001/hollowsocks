{%- liquid
  assign show_announcement = false
  assign announcement_block_count = 0
  assign first_block = nil
  for block in section.blocks
    if block.type == 'announcement' or block.type == '@app'
      assign show_announcement = true
      assign announcement_block_count = announcement_block_count | plus: 1
      if first_block == nil
        assign first_block = block
      endif
    endif
  endfor

  assign heading = section.settings.heading | default: first_block.settings.text
  assign offer = section.settings.offer | default: first_block.settings.link_text
  assign link = section.settings.link | default: first_block.settings.link
  assign end_date = section.settings.end_datetime | default: '2026-09-07T23:59:59'
-%}

{% if show_announcement %}
  <div
    class="announcement-bar hollow-announcement"
    data-sticky="{{ section.settings.sticky_on_scroll }}"
    data-sticky-mobile="{{ section.settings.sticky_on_mobile }}"
  >
    <div class="hollow-announcement__inner page-width">
      {%- if link != blank -%}
        <a class="hollow-announcement__copy" href="{{ link }}">
      {%- else -%}
        <div class="hollow-announcement__copy">
      {%- endif -%}
        {%- if heading != blank -%}
          <span class="hollow-announcement__title">{{ heading }}</span>
        {%- endif -%}
        {%- if offer != blank -%}
          <span class="hollow-announcement__offer">{{ offer }}</span>
        {%- endif -%}
      {%- if link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_countdown -%}
        <div
          class="hollow-countdown"
          data-hollow-countdown
          data-end="{{ end_date | escape }}"
        >
          <div class="hollow-countdown__unit">
            <span class="hollow-countdown__box" data-unit="hours">00</span>
            <span class="hollow-countdown__label">HR</span>
          </div>
          <span class="hollow-countdown__sep" aria-hidden="true">:</span>
          <div class="hollow-countdown__unit">
            <span class="hollow-countdown__box" data-unit="minutes">00</span>
            <span class="hollow-countdown__label">MIN</span>
          </div>
          <span class="hollow-countdown__sep" aria-hidden="true">:</span>
          <div class="hollow-countdown__unit">
            <span class="hollow-countdown__box" data-unit="seconds">00</span>
            <span class="hollow-countdown__label">SEC</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
{% endif %}
