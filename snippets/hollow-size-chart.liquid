{%- liquid
  assign chart_title = block.settings.hollow_size_chart_title
  assign chart_note = block.settings.hollow_size_chart_note
  assign chart_image = block.settings.hollow_size_chart_image
  assign chart_image_alt = block.settings.hollow_size_chart_image_alt
  assign col_size = block.settings.hollow_size_col_size
  assign col_m = block.settings.hollow_size_col_m
  assign col_l = block.settings.hollow_size_col_l
  assign col_xl = block.settings.hollow_size_col_xl
  assign row_men = block.settings.hollow_size_row_men
  assign men_m = block.settings.hollow_size_men_m
  assign men_l = block.settings.hollow_size_men_l
  assign men_xl = block.settings.hollow_size_men_xl
  assign row_women = block.settings.hollow_size_row_women
  assign women_m = block.settings.hollow_size_women_m
  assign women_l = block.settings.hollow_size_women_l
  assign women_xl = block.settings.hollow_size_women_xl
-%}

<div class="hollow-size-chart" id="HollowSizeChart">
  <div class="hollow-size-chart__head">
    {%- if chart_title != blank -%}
      <h2 class="hollow-size-chart__title">{{ chart_title | escape }}</h2>
    {%- endif -%}
    {%- if chart_note != blank -%}
      <span class="hollow-size-chart__note">{{ chart_note | escape }}</span>
    {%- endif -%}
  </div>
  {%- if chart_image != blank -%}
    <div class="hollow-size-chart__image-wrap">
      {{ chart_image
        | image_url: width: 1600
        | image_tag:
          class: 'hollow-size-chart__image',
          loading: 'lazy',
          widths: '400, 600, 800, 1000, 1200, 1600',
          sizes: '(max-width: 768px) calc(100vw - 40px), 620px',
          alt: chart_image_alt
      }}
    </div>
  {%- else -%}
    <div class="hollow-size-chart__table-wrap">
      <table class="hollow-size-chart__table">
        <thead>
          <tr>
            <th scope="col">{{ col_size | escape }}</th>
            <th scope="col">{{ col_m | escape }}</th>
            <th scope="col">{{ col_l | escape }}</th>
            <th scope="col">{{ col_xl | escape }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ row_men | escape }}</th>
            <td>{{ men_m | escape }}</td>
            <td>{{ men_l | escape }}</td>
            <td>{{ men_xl | escape }}</td>
          </tr>
          <tr>
            <th scope="row">{{ row_women | escape }}</th>
            <td>{{ women_m | escape }}</td>
            <td>{{ women_l | escape }}</td>
            <td>{{ women_xl | escape }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  {%- endif -%}
</div>
