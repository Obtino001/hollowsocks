<div class="hollow-size-chart" id="HollowSizeChart">
  <div class="hollow-size-chart__head">
    <h2 class="hollow-size-chart__title">SIZE CHART</h2>
    <span class="hollow-size-chart__note">Show Size (US)</span>
  </div>
  <div class="hollow-size-chart__table-wrap">
    <table class="hollow-size-chart__table">
      <thead>
        <tr>
          <th scope="col">SIZE</th>
          <th scope="col">MEDIUM</th>
          <th scope="col">LARGE</th>
          <th scope="col">XL</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Men</th>
          <td>6 - 9</td>
          <td>9.5 - 12</td>
          <td>12.5 - 15</td>
        </tr>
        <tr>
          <th scope="row">Women</th>
          <td>7 - 9.5</td>
          <td>10 - 13</td>
          <td>-</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
