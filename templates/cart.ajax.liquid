{% comment %}
  JS-load cart markup without bloat of a full layout.

  This is used in both the cart drawer and cart page.
  When a quantity is changed, this file is scraped and data-products
    is fully replaced to account for possible cart discounts changing

  The cart-wide discount div also replaces what is originally in the cart
    as it can change anytime a cart-item changes
{% endcomment %}
{% layout none %}

{%- liquid
  assign hollow_bundle_count = 0
  assign hollow_bundle_total = 0
  assign hollow_bundle_discount = 0
  for item in cart.items
    if item.original_price == 29900
      for item_collection in item.product.collections
        if item_collection.handle == 'alle-monstre'
          assign hollow_bundle_count = hollow_bundle_count | plus: item.quantity
          assign hollow_bundle_total = hollow_bundle_total | plus: item.final_line_price
          assign hollow_bundle_discount = hollow_bundle_discount | plus: item.line_level_total_discount
          break
        endif
      endfor
    endif
  endfor
-%}
<div class="cart__items"
  data-count="{{ cart.item_count }}"
  data-cart-subtotal="{{ cart.total_price }}"
  data-bundle-count="{{ hollow_bundle_count }}"
  data-bundle-total="{{ hollow_bundle_total }}"
  data-bundle-discount="{{ hollow_bundle_discount }}">
  {% for item in cart.items %}
    {%- render 'cart-item', product: item, sizes: '100px', -%}
  {% endfor %}
</div>
<div class="cart__discounts cart__item-sub cart__item-row{% if cart.cart_level_discount_applications == blank %} hide{% endif %}">
  <div>{{ 'cart.general.discounts' | t }}</div>
  <div>
    {% for cart_discount in cart.cart_level_discount_applications %}
      <div class="cart__discount">
        {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
      </div>
    {% endfor %}
  </div>
</div>
