    "hollow_reviews_4WGVMN": {
      "type": "hollow-reviews",
      "blocks": {
        "image_X3j7Yq": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_101302_9683d0fa-bc42-434f-9059-cd3b51bae494.jpg",
            "tall": false
          }
        },
        "review_dLRkrF": {
          "type": "review",
          "settings": {
            "quote": "Jeg kunne ikke lade være med at bestille Stevns, fordi min mormor voksede op der.\n\nJeg aner ikke, om mønsteret har noget med hende at gøre. Men jeg sad og kiggede på det og tænkte på hende, og så bestilte jeg det.\n\nHun strikkede til os, da vi var små. Hun holdt op i 2009, og ingen af os lærte det. Det er nok derfor, det ramte.\n\nSokkerne er i øvrigt rigtig gode og behagelige. Men det var ikke derfor, jeg købte dem.",
            "author": "Hanne, Aalborg",
            "meta": ""
          }
        },
        "review_GBtHfY": {
          "type": "review",
          "settings": {
            "quote": "Jeg har altid sagt nej til uldsokker, fordi jeg ikke kan holde ud, når de kradser. De her gør ikke. Jeg har dem på uden noget under, og jeg mærker dem slet ikke. Havde ikke regnet med det. Kan anbefales. Men der var vist ikke mange tilbage, da jeg var inde sidst. #strikkestuen",
            "author": "Birgitte, Aarhus",
            "meta": ""
          }
        },
        "image_yy8gQP": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_174843_3aa25497-b3e6-4ac8-9425-cd2cd70bc9d7.jpg",
            "tall": false
          }
        },
        "image_dmGgQQ": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_180627_d559d00b-06e0-4675-9c43-f5d5902ab1b0.jpg",
            "tall": false
          }
        },
        "review_XaJFRD": {
          "type": "review",
          "settings": {
            "quote": "Jeg var skeptisk over prisen, indtil jeg fik dem i hånden. De er væsentligt tykkere end dem, jeg har købt tidligere og langt mere behagelige at have på. Eneste lille minus er at de er 1-2 dage om at tørre men de kan vaskes i maskine uden problemer på 30 grader. #strikkestuen",
            "author": "Mette, Odense",
            "meta": ""
          }
        },
        "review_iGT9R6": {
          "type": "review",
          "settings": {
            "quote": "Tredje gang jeg bestiller. Nu har hele familien fået et par. Har vasket de første fire-fem gange. De har ikke ændret sig. Bestiller julegaverne her igen i år.",
            "author": "Lone, Vejle",
            "meta": ""
          }
        },
        "image_XiPRCn": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_180936_14276477-aaaa-4611-b715-a0060384bd19.jpg",
            "tall": false
          }
        },
        "image_HxQYYV": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_104942_ff01585a-bd9a-40c2-965b-4b5e3cdf8170.jpg",
            "tall": true
          }
        },
        "review_p6xzYd": {
          "type": "review",
          "settings": {
            "quote": "Jeg valgte Mols, fordi min farmor kom derfra. Det betød mere, end jeg regnede med. Jeg bruger mine hele tiden på arbejde og i fritiden. Kan varmt anbefale!",
            "author": "Thomas, København",
            "meta": ""
          }
        },
        "review_qHL6Xy": {
          "type": "review",
          "settings": {
            "quote": "Jeg har kasseret så mange uldsokker med hul i hælen, at jeg holdt op med at købe dem.\n\nHar haft disse på hele tiden siden slutningen af september. Hælen ser ud som dagen jeg fik dem. Første gang jeg har haft et par, hvor jeg ikke bare venter på, at de går i stykker. #strikkestuen",
            "author": "Inger, Silkeborg",
            "meta": ""
          }
        },
        "image_QtbH7X": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_105230_59126d5b-ab3c-48c2-9a1c-15aa5d3a64d9.jpg",
            "tall": false
          }
        },
        "image_tHRC9F": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_105750_90ac6284-d76b-4e31-ab40-74053b5bb8f1.jpg",
            "tall": false
          }
        },
        "review_D8WRBp": {
          "type": "review",
          "settings": {
            "quote": "Jeg har før ødelagt uld i maskinen, så jeg turde ikke vaske dem først. Men der stod 30 grader på uldprogram, så jeg prøvede. De er præcis samme størrelse som før. Det tager dog et par dage før de er helt tørre, så man skal være lidt tålmodig..",
            "author": "Kirsten, Esbjerg",
            "meta": ""
          }
        },
        "review_TLF36w": {
          "type": "review",
          "settings": {
            "quote": "Jeg havde et par fra et andet mærke til halv pris liggende ved siden af.\nForskellen er til at tage og føle på. Garnet er tykkere, og der er ikke de der tynde steder, hvor man kan se igennem. Man får altså hvad man betaler for. #strikkestuen",
            "author": "Susanne, Roskilde",
            "meta": ""
          }
        },
        "image_7VYHkC": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_110257_ffd8e498-4fa2-4c9e-930d-a15f9049fd39.jpg",
            "tall": false
          }
        },
        "image_NdCwVa": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_111057_1b9033c0-f6bb-4d95-96d9-a144b21df8d0.jpg",
            "tall": false
          }
        },
        "review_KVQR3d": {
          "type": "review",
          "settings": {
            "quote": "Købte de første i september. De har været i vask mindst ti gange nu.\nIngen huller, ingen krympning, mønsteret er lige så skarpt som dag et. Det er derfor, jeg bestiller flere i stedet for at prøve noget andet. #strikkestuen",
            "author": "Jette, Horsens",
            "meta": ""
          }
        },
        "review_XmzRQi": {
          "type": "review",
          "settings": {
            "quote": "Fik dem af min datter. Jeg havde ikke bedt om noget, og jeg manglede heller ikke noget.\nNu står de ved døren, og jeg tager dem på, så snart jeg kommer hjem. Hun siger, hun har bestilt flere til jul",
            "author": "Erik, Viborg",
            "meta": ""
          }
        },
        "image_rXmXCN": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_111437_02feea29-6621-4bcf-8226-2eb8d4b87073.jpg",
            "tall": false
          }
        },
        "review_xiCXVb": {
          "type": "review",
          "settings": {
            "quote": "Vores hus er fra 1954. Der er to grader forskel på stuen og gangen.\n\nJeg har prøvet tøfler, men de sidder ikke fast, og man kan ikke have dem på i sengen. De her kan jeg have på hele dagen.",
            "author": "Marianne, Haderslev",
            "meta": ""
          }
        },
        "image_FFBtPk": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_112040_95cba69c-14d5-4f08-8736-89e89c2fe4ab.jpg",
            "tall": false
          }
        },
        "image_4LgUMr": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_112257_dc74f4a2-8173-475f-9945-239ebc57a9b1.jpg",
            "tall": true
          }
        },
        "review_4kWJBT": {
          "type": "review",
          "settings": {
            "quote": "Jeg har haft uld strømper før, men de var tynde som papir.\nDisse er noget helt andet. Man kan mærke, at der er garn i dem.",
            "author": "Charlotte, Næstved",
            "meta": ""
          }
        },
        "review_UQTV3j": {
          "type": "review",
          "settings": {
            "quote": "Brugte en halv time på at vælge, fordi jeg ikke kunne bestemme mig.\nEndte med fire forskellige, og det var det rigtige.",
            "author": "Anne, Herning",
            "meta": ""
          }
        },
        "image_aKMBLQ": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_112643_17553487-3a84-4394-9232-807afd35e7d2.jpg",
            "tall": false
          }
        },
        "image_MdxtwV": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_113243_fd651b2b-fd32-45f2-bd89-c9cf0b7ecf73.jpg",
            "tall": true
          }
        },
        "review_P4Fwc3": {
          "type": "review",
          "settings": {
            "quote": "Jeg ledte overhovedet ikke efter sokker. Jeg så en annonce om, at ingen strikker dem længere. Min mormor strikkede til os alle sammen, indtil hun ikke kunne mere. Jeg har ikke haft et par siden. Bestilte fire på stedet.",
            "author": "Pernille, Slagelse",
            "meta": ""
          }
        },
        "review_n33faq": {
          "type": "review",
          "settings": {
            "quote": "Jeg er sygeplejerske og går tolv timer på et linoleumsgulv.\n\nHar prøvet alt muligt. De her er de første, der ikke er klemt flade efter fire timer. Jeg har et par i skabet på arbejdet nu.",
            "author": "Camilla, Odense",
            "meta": ""
          }
        },
        "image_kayBRD": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_114027_7c2d8949-0513-4af1-aee2-ecc561776eb5.jpg",
            "tall": false
          }
        },
        "image_TXHnyq": {
