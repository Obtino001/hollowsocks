      "blocks": {
        "faq_wiEMbF": {
          "type": "faq",
          "settings": {
            "question": "Hvordan virker rabatten?",
            "answer": "<p>Du lægger bare de par i kurven, du vil have. Prisen falder automatisk, når du når fire — og igen ved seks. Du skal ikke bruge en kode.</p><p>Mønstrene må gerne være forskellige.</p>"
          }
        },
        "faq_RtcxJX": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "WHY DOES ALPACA PERFORM BETTER?",
            "answer": "<p>Alpaca fleece is naturally hollow, trapping heat efficiently while remaining breathable and moisture-wicking.</p>"
          }
        },
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "Kradser de?",
            "answer": "<p><br/>Nej. Garnet er blødt nok til at have på uden noget under. Kløe er den eneste grund til, at folk holdt op med at bruge uldsokker — og det problem er løst.<br/><br/></p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "Kan jeg vælge forskellige mønstre?",
            "answer": "<p><br/>Ja. Du må gerne blande frit. Rabatten beregnes på antal par, ikke på mønster.<br/><br/></p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "Kan de vaskes i maskine?",
            "answer": "<p>Ja, 30 grader på uldprogram. Brug uldvaskemiddel og læg dem fladt til tørre. Ikke i tørretumbler — det er det eneste, der kan ødelægge dem.<br/><br/></p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "Hvilken størrelse skal jeg vælge?",
            "answer": "<p>Vælg den, der passer til din normale skostørrelse. Er du lige mellem to, så tag den største.<br/><br/></p>"
          }
        },
        "faq_pURaxa": {
          "type": "faq",
          "settings": {
            "question": "Hvad hvis der går hul?",
            "answer": "<p>Så sender vi et nyt par. Garantien løber i 12 måneder, og du skal ikke sende de gamle retur.<br/><br/></p>"
          }
        }
