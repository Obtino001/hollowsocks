        "review_VTHqex": {
          "type": "review",
          "settings": {
            "quote": "Jeg ledte overhovedet ikke efter sokker. Jeg så en annonce om, at ingen strikker dem længere. Min mormor strikkede til os alle sammen, indtil hun ikke kunne mere. Jeg har ikke haft et par siden. Bestilte fire på stedet.",
            "author": "Pernille, Slagelse",
            "meta": ""
          }
        },
        "review_BnJNJd": {
          "type": "review",
          "settings": {
            "quote": "Jeg er sygeplejerske og går tolv timer på et linoleumsgulv.\n\nHar prøvet alt muligt. De her er de første, der ikke er klemt flade efter fire timer. Jeg har et par i skabet på arbejdet nu.",
            "author": "Camilla, Odense",
            "meta": ""
          }
        },
