{
  "sections": {
    "about": {
      "type": "hollow-about",
      "blocks": {
        "t1": {
          "type": "timeline",
          "settings": {
            "year": "",
            "title": "Jeg tog dem med hjem. Jeg troede, jeg ville lære det.",
            "text": "Jeg forsøgte i fire år. Jeg kunne ikke engang læse dem — hun skrev i forkortelser,\nsom kun hun forstod, og der stod ikke noget om, hvad der skulle ske efter række 40.\nJeg lagde dem væk."
          }
        },
        "t2": {
          "type": "timeline",
          "settings": {
            "year": "",
            "title": "SÅ FANDT JEG NOGEN, DER KUNNE",
            "text": "Jeg hedder Margit. Jeg kan ikke strikke, og jeg kommer aldrig til det. Men jeg fandt kvinder, der kan. Kvinder, der har gjort det hele deres liv, og som\ner de sidste, der gør det.\nJeg gav dem mormors mønstre. De kunne læse dem med det samme. En af dem grinede og\nsagde, at hendes egen mor skrev på præcis samme måde.\n\nDet er dem, der laver de sokker, jeg sælger. Ikke mig. Min del er at holde mønstrene i live og sørge for, at de ikke bliver liggende i en skuffe igen. Det er dansk håndværk, og der er ikke mange tilbage, der bærer det videre. Nogen skal gøre det. Ellers forsvinder de med den sidste, der kan læse dem."
          }
        },
        "t3": {
          "type": "timeline",
          "settings": {
            "year": "",
            "title": "OM MØNSTRENE",
            "text": "Der findes ikke ét dansk strikkemønster. Der findes mange, og de er forskellige\nfra egn til egn, fordi kvinderne på Fanø ikke strikkede som kvinderne på Læsø.\n\nHvert par, du finder her, følger ét bestemt mønster fra ét bestemt sted.\n\nDet er ikke pynt. Det er et mønster, nogen sad med i hånden for hundrede år siden,\nfordi det var sådan, man gjorde det, hvor de kom fra."
          }
        },
        "f1": {
          "type": "feature",
          "settings": {
            "title": "HVORFOR JEG GØR DET",
            "text": "Jeg tror ikke, folk savner uldsokker.\n\nJeg tror, de savner at få noget, som nogen har brugt tid på.\n\nDer er en hel generation, der ikke får et par igen. Ikke fordi de ikke vil have\ndem, men fordi den, der lavede dem, er holdt op — og fordi ingen af os lærte det.\n\nJeg kunne ikke lære det. Det her er det, jeg kunne gøre i stedet."
          }
        },
        "f2": {
          "type": "feature",
          "disabled": true,
          "settings": {
            "title": "BREATHABLE & LIGHT",
            "text": "Alpaca fiber is naturally lightweight and breathable allowing it to adapt to any temperature while keeping you comfortable even in the harshest conditions."
          }
        },
        "f3": {
          "type": "feature",
          "disabled": true,
          "settings": {
            "title": "SOFT ALPACA FIBER",
            "text": "Alpaca fibers are naturally smooth, and have a lower scale structure—meaning no coarse, or itchy feeling you get with wool."
          }
        },
        "f4": {
          "type": "feature",
          "disabled": true,
          "settings": {
            "title": "MOISTURE WICKING",
            "text": "Alpaca fibers naturally repel moisture thanks to their low absorption rate, about 8% versus wool’s 30%, and cotton’s 60%."
          }
        },
        "f5": {
          "type": "feature",
          "disabled": true,
          "settings": {
            "title": "ODOR RESISTANT",
            "text": "Unlike synthetic socks that trap moisture and odor over time, alpaca fibers make bacterial growth difficult, reducing the root cause of foot odor."
          }
        }
      },
      "block_order": [
