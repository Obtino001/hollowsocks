      "settings": {
        "hero_heading": "MIN MORMOR STRIKKEDE SOKKER TIL HELE FAMILIEN. JEG LÆRTE DET ALDRIG.",
        "hero_text": "Mormor sad i den samme stol hver aften og strikkede, mens hun kiggede på os. Vi fik et par hver til jul. Hvert eneste år. Ingen af os sagde rigtig tak for dem.\nDe var bare der, som noget der altid ville være der.",
        "fiber_title": "Hun holdt op i 2011, fordi hendes hænder ikke kunne mere.",
        "fiber_eyebrow": "",
        "fiber_story_title": "Ingen i familien har fået et par siden.",
        "fiber_text": "Da vi tømte hendes lejlighed, fandt jeg en skuffe med hendes opskrifter.\nHåndskrevne. Nogle af dem på papir, der var revet ud af regnskabsbøger fra\nhalvfjerdserne.",
        "fiber_image": "shopify://shop_images/hf_20261007_185139_ae49af45-04d6-4f60-9477-5691fd528961.jpg",
        "means_heading": ""
      }
    },
