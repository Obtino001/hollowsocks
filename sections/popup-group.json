{
  "type": "custom.popups",
  "name": "t:sections.popup-group.name",
  "sections": {
    "hollow-luck": {
      "type": "hollow-luck-popup",
      "settings": {
        "enable": true,
        "title": "TRY YOUR LUCK",
        "text": "Match 3 cards to see what you win.",
        "dismiss_label": "No thanks",
        "win_text": "You matched 3 — use code HOLLOW at checkout.",
        "lose_text": "No match this time. Shop the sale anyway.",
        "delay": 1
      }
    },
    "newsletter-popup": {
      "type": "newsletter-popup",
      "disabled": true,
      "blocks": {
        "reminder-block": {
          "type": "header",
          "disabled": true,
          "settings": {}
        }
      },
      "block_order": ["reminder-block"],
      "settings": {
        "disable_for_account_holders": true,
        "popup_seconds": 5,
        "popup_days": 30,
        "popup_title": "Save 10% on your first order",
        "popup_text": "<p>Join our email list for exclusive offers and early access to new arrivals.</p>",
        "image_position": "left",
        "show_social_icons": false,
        "enable_newsletter": true,
        "button_label": "Get 10% Off",
        "button_link": ""
      }
    },
    "age-verification-popup": {
      "type": "age-verification-popup",
      "disabled": true,
      "settings": {}
    }
  },
  "order": ["hollow-luck", "newsletter-popup", "age-verification-popup"]
}
