<section class="hollow-wins" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-wins__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="hollow-wins__grid">
      {%- for block in section.blocks -%}
        <article class="hollow-wins__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', class: 'hollow-wins__image', widths: '320, 480, 720' }}
          {%- else -%}
            <div class="hollow-wins__image hollow-wins__image--empty" aria-hidden="true"></div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="hollow-wins__heading">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="hollow-wins__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow why we win",
  "class": "hollow-wins-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Hollow Wins? Feature by Feature."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Graduated Compression" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow why we win",
      "blocks": [
        { "type": "feature", "settings": { "title": "Graduated Compression", "text": "Firm at the ankle, easing up the calf. Keeps blood moving and swelling down through long days on your feet." } },
        { "type": "feature", "settings": { "title": "Non-Binding Cuff", "text": "Stays up without digging in. No marks, no indentations — just clean, comfortable compression when you take them off." } },
        { "type": "feature", "settings": { "title": "Alpaca Fiber", "text": "Naturally soft, breathable, and moisture-wicking. Gentler on sensitive skin than merino or synthetic blends." } },
        { "type": "feature", "settings": { "title": "easy on, easy off", "text": "Stretches wide enough to slide over swollen feet and calves. On in seconds, no struggle, no dreading the morning." } },
        { "type": "feature", "settings": { "title": "Recommended by Podiatrists", "text": "Hollow Alpaca Compression Socks are recommended by Dr. Dana Figura, a board-certified podiatric foot and ankle surgeon." } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}
