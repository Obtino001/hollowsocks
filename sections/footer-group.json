            "tall": false
          }
        },
        "review_1": {
          "type": "review",
          "settings": {
            "quote": "Jeg har altid frosset om fødderne om efteråret og vinteren. Jeg troede bare, det var sådan, det var.\n\nHar haft dem på hver aften siden de kom. Det er første år, jeg ikke sidder med tæppe over benene i stuen.",
            "author": "Hanne, Aalborg",
            "meta": ""
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "quote": "Jeg har altid sagt nej til uldsokker, fordi jeg ikke kan holde ud, når de kradser. De her gør ikke. Jeg har dem på uden noget under, og jeg mærker dem slet ikke. Havde ikke regnet med det. Kan anbefales",
            "author": "Birgitte, Aarhus",
            "meta": ""
          }
        },
        "image_2": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_174843_3aa25497-b3e6-4ac8-9425-cd2cd70bc9d7.jpg",
            "tall": false
          }
        },
        "image_3": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_180627_d559d00b-06e0-4675-9c43-f5d5902ab1b0.jpg",
            "tall": false
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "quote": "Jeg var skeptisk over prisen, indtil jeg fik dem i hånden. De er væsentligt tykkere end dem, jeg har købt tidligere.",
            "author": "Mette, Odense",
            "meta": ""
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "quote": "Tredje gang jeg bestiller. Nu har hele familien fået et par. Har vasket de første fire-fem gange. De har ikke ændret sig. Bestiller julegaverne her igen i år.",
            "author": "Lone, Vejle",
            "meta": ""
          }
        },
        "image_4": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261008_180936_14276477-aaaa-4611-b715-a0060384bd19.jpg",
            "tall": false
          }
        },
        "image_b4TAWQ": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_104942_ff01585a-bd9a-40c2-965b-4b5e3cdf8170.jpg",
            "tall": true
          }
        },
        "review_BGVfzz": {
          "type": "review",
          "settings": {
            "quote": "Jeg valgte Mols, fordi min farmor kom derfra. Det betød mere, end jeg regnede med. Jeg bruger mine hele tiden. Kan varmt anbefale!",
            "author": "Thomas, København",
            "meta": ""
          }
        },
        "review_RwmycX": {
          "type": "review",
          "settings": {
            "quote": "Jeg har kasseret så mange uldsokker med hul i hælen, at jeg holdt op med at købe dem.\n\nHar haft disse på hele siden slutningen af september. Hælen ser ud som dagen jeg fik dem. Første gang jeg har haft et par, hvor jeg ikke bare venter på, at de går i stykker.",
            "author": "Inger, Silkeborg",
            "meta": ""
          }
        },
        "image_Jp6teU": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_105230_59126d5b-ab3c-48c2-9a1c-15aa5d3a64d9.jpg",
            "tall": false
          }
        },
        "image_3XmtaE": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_105750_90ac6284-d76b-4e31-ab40-74053b5bb8f1.jpg",
            "tall": false
          }
        },
        "review_Cr3FxE": {
          "type": "review",
          "settings": {
            "quote": "Jeg har ødelagt to uldtrøjer i maskinen, så jeg turde ikke vaske dem først. Men der stod 30 grader på uldprogram, så jeg prøvede. De er præcis samme størrelse som før. Det tager dog et par dage før de er helt tørre, så man skal være lidt tålmodig..",
            "author": "Kirsten, Esbjerg",
            "meta": ""
          }
        },
        "review_8jmg9x": {
          "type": "review",
          "settings": {
            "quote": "Jeg havde et par fra et andet mærke til halv pris liggende ved siden af.\nForskellen er til at tage og føle på. Garnet er tykkere, og der er ikke de der tynde steder, hvor man kan se igennem. Man får altså hvad man betaler for.",
            "author": "Susanne, Roskilde",
            "meta": ""
          }
        },
        "image_VMzHQU": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_110257_ffd8e498-4fa2-4c9e-930d-a15f9049fd39.jpg",
            "tall": false
          }
        },
        "image_94HcpE": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/hf_20261010_111057_1b9033c0-f6bb-4d95-96d9-a144b21df8d0.jpg",
            "tall": false
          }
        },
        "review_V69xDR": {
          "type": "review",
          "settings": {
            "quote": "Købte de første i september. De har været i vask mindst ti gange nu.\nIngen huller, ingen krympning, mønsteret er lige så skarpt som dag et. Det er derfor, jeg bestiller flere i stedet for at prøve noget andet.",
            "author": "Jette, Horsens",
            "meta": ""
          }
        },
        "review_hnhLBK": {
          "type": "review",
          "settings": {
            "quote": "Fik dem af min datter. Jeg havde ikke bedt om noget, og jeg manglede heller ikke noget.\nNu står de ved døren, og jeg tager dem på, så snart jeg kommer hjem. Hun siger, hun har bestilt flere til jul",
            "author": "Erik, Viborg",
            "meta": ""
          }
        },
        "image_MzDHFL": {
