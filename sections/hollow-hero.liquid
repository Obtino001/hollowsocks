{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section class="hollow-hero" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="hollow-hero__media">
      {%- render 'image-element',
        img: section.settings.image,
        img_width: 2400,
        loading: 'eager',
        widths: '720, 900, 1080, 1400, 1800, 2400'
      -%}
    </div>
  {%- else -%}
    <div class="hollow-hero__placeholder" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hollow-hero__overlay" style="background: rgba(0,0,0,{{ overlay_alpha }});"></div>

  <div class="hollow-hero__content page-width">
    <div class="page-width">
      <div class="hollow-hero__copy">
        {%- if section.settings.kicker != blank -%}
          <p class="hollow-hero__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hollow-hero__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hollow-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="hollow-hero__cta" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | remove: '—' | strip }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow hero",
  "tag": "section",
  "class": "hollow-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 12
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "KNITTED IN THE U.S.A." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "LABOR DAY SALE" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Alpaca fiber sourced from Peru, knit into every pair here in the U.S."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP BEST SELLERS" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hollow hero" }],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
