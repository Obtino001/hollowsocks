{%- liquid
  assign cols = section.settings.columns_desktop | default: 3
  assign radius = section.settings.image_radius | default: 10
-%}

<section
  class="hollow-advantage"
  id="Advantage-{{ section.id }}"
  style="
    --adv-bg: {{ section.settings.bg_color }};
    --adv-text: {{ section.settings.text_color }};
    --adv-cols: {{ cols }};
    --adv-radius: {{ radius }}px;
    --adv-pad-top: {{ section.settings.padding_top }}px;
    --adv-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hollow-advantage__inner page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="hollow-advantage__header">
        {%- if section.settings.title != blank -%}
          <div class="hollow-advantage__heading">{{ section.settings.title }}</div>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="hollow-advantage__subheading">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="hollow-advantage__grid">
      {%- for block in section.blocks -%}
        <article class="hollow-advantage__item" {{ block.shopify_attributes }}>
          <div class="hollow-advantage__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900',
                  sizes: '(min-width: 990px) 30vw, 90vw',
                  alt: block.settings.title
              }}
            {%- else -%}
              <div class="hollow-advantage__fallback" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          <div class="hollow-advantage__copy">
            {%- if block.settings.title != blank -%}
              <div class="hollow-advantage__title">{{ block.settings.title }}</div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hollow-advantage__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advantage Grid",
  "tag": "section",
  "class": "hollow-advantage-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE HOLLOW ADVANTAGE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "See why thousands of hunters trust Hollow Hunt Socks"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Card",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ENDURANCE TESTED COMFORT"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Rain or shine. Hot or cold. No matter the environment Hollow Hunt Socks stays comfortable so you can focus on the hunt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advantage Grid",
      "blocks": [
        {
          "type": "grid_item",
          "settings": {
            "title": "ENDURANCE TESTED COMFORT",
            "text": "Rain or shine. Hot or cold. No matter the environment Hollow Hunt Socks stays comfortable so you can focus on the hunt."
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "ENGINEERED FOR VERSATILITY",
            "text": "Designed to adapt to the changing environment of fast and agile moving hunts."
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "EASY ON, EASY OFF",
            "text": "Stretches wide enough to slide over feet and calves. On in seconds without the struggle."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}
