<section class="hollow-fiber" data-section-id="{{ section.id }}">
  <div class="page-width hollow-fiber__wrap">
    <div class="hollow-fiber__copy-top">
      {%- if section.settings.title != blank -%}
        <h2 class="hollow-fiber__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="hollow-fiber__eyebrow">
          <span class="hollow-fiber__pin">{%- render 'hollow-icon', name: 'pin' -%}</span>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
    </div>

    <div class="hollow-fiber__layout">
      <div class="hollow-fiber__main">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'hollow-fiber__hero-image', widths: '720, 1080, 1400' }}
        {%- else -%}
          <div class="hollow-fiber__hero-fallback" aria-hidden="true"></div>
        {%- endif -%}
      </div>

      <div class="hollow-fiber__side">
        <div class="hollow-fiber__circles">
          {%- if section.settings.circle_1 != blank -%}
            {{ section.settings.circle_1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'hollow-fiber__circle hollow-fiber__circle--top' }}
          {%- else -%}
            <div class="hollow-fiber__circle hollow-fiber__circle--top hollow-fiber__circle--empty" aria-hidden="true"></div>
          {%- endif -%}
          {%- if section.settings.circle_2 != blank -%}
            {{ section.settings.circle_2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'hollow-fiber__circle hollow-fiber__circle--bottom' }}
          {%- else -%}
            <div class="hollow-fiber__circle hollow-fiber__circle--bottom hollow-fiber__circle--empty" aria-hidden="true"></div>
          {%- endif -%}
          <span class="hollow-fiber__line" aria-hidden="true"></span>
        </div>
        <div class="hollow-fiber__story">
          {%- if section.settings.story_title != blank -%}
            <h3 class="hollow-fiber__story-title">{{ section.settings.story_title }}</h3>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="hollow-fiber__text">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="hollow-fiber__cta" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow fiber story",
  "class": "hollow-story-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why Alpaca Fiber Outperforms Wool and Cotton" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ethically sourced in the high altitudes of peru" },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "image_picker", "id": "circle_1", "label": "Top circle image" },
    { "type": "image_picker", "id": "circle_2", "label": "Bottom circle image" },
    { "type": "text", "id": "story_title", "label": "Story heading", "default": "hollow by nature" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Unlike cotton and wool, alpaca fiber is naturally hollow, creating breathable warmth and dry comfort without bulk." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hollow fiber story" }],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}
