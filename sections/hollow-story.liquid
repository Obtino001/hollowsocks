<section id="hollow-fiber-{{ section.id }}" class="hollow-fiber-section">
  <div class="hf-background-logo" aria-hidden="true">
    <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M37 128L57.5865 113.499V0H37V128Z" fill="currentColor"></path>
      <path d="M70.0234 104.846L90.6109 90.3444V0H70.0234V104.846Z" fill="currentColor"></path>
    </svg>
  </div>

  <div class="hf-container">
    <div class="hf-layout">
      
      <!-- LEFT COLUMN -->
      <div class="hf-left-col">
        <div class="hf-heading-stack">
          {%- if section.settings.title != blank -%}
            <h2 class="hf-title">{{ section.settings.title }}</h2>
          {%- endif -%}
          
          {%- if section.settings.eyebrow != blank -%}
            <div class="hf-eyebrow">
              <span class="hf-icon-pin">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24.3 0C15.012 0 7.5 7.512 7.5 16.8C7.5 29.4 24.3 48 24.3 48C24.3 48 41.1 29.4 41.1 16.8C41.1 7.512 33.588 0 24.3 0ZM24.3 22.8C22.7087 22.8 21.1826 22.1679 20.0574 21.0426C18.9321 19.9174 18.3 18.3913 18.3 16.8C18.3 15.2087 18.9321 13.6826 20.0574 12.5574C21.1826 11.4321 22.7087 10.8 24.3 10.8C25.8913 10.8 27.4174 11.4321 28.5426 12.5574C29.6679 13.6826 30.3 15.2087 30.3 16.8C30.3 18.3913 29.6679 19.9174 28.5426 21.0426C27.4174 22.1679 25.8913 22.8 24.3 22.8Z" fill="currentColor"></path>
                </svg>
              </span>
              <span class="hf-eyebrow-text">{{ section.settings.eyebrow }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="hf-main-image-wrap">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'hf-image-cover' }}
          {%- else -%}
            <div class="hf-placeholder hf-image-cover"></div>
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="hf-right-col">
        <!-- Top Circle -->
        <div class="hf-circle hf-circle-top">
          {%- if section.settings.circle_1 != blank -%}
            {{ section.settings.circle_1 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'hf-image-cover' }}
          {%- else -%}
             <div class="hf-placeholder hf-image-cover"></div>
          {%- endif -%}
        </div>

        <!-- Connector Line -->
        <div class="hf-connector"></div>

        <!-- Bottom Circle -->
        <div class="hf-circle hf-circle-bottom">
          {%- if section.settings.circle_2 != blank -%}
            {{ section.settings.circle_2 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'hf-image-cover' }}
          {%- else -%}
            <div class="hf-placeholder hf-image-cover"></div>
          {%- endif -%}
        </div>

        <!-- Story Content -->
        <div class="hf-story">
          {%- if section.settings.story_title != blank -%}
            <h3 class="hf-story-title">{{ section.settings.story_title }}</h3>
          {%- endif -%}
          
          {%- if section.settings.text != blank -%}
            <div class="hf-story-text">
              <p>{{ section.settings.text }}</p>
            </div>
          {%- endif -%}
          
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="hf-cta">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  :root {
    --hf-bg-color: #f6f5f0;
    --hf-text-color: #282828;
    --hf-primary-color: #1c2e21; /* Dark green line color */
    --hf-accent: #e4dec8;
  }

  .hollow-fiber-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--hf-bg-color);
    color: var(--hf-text-color);
    padding: 60px 20px;
    font-family: inherit;
  }

  /* Background Watermark */
  .hf-background-logo {
    position: absolute;
    top: -20px;
    right: 20px;
    width: 150px;
    color: var(--hf-accent);
    opacity: 0.6;
    pointer-events: none;
    z-index: 1;
    transform: scale(0.6);
    transform-origin: right top;
  }

  .hf-container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .hf-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hf-image-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hf-placeholder {
    background-color: #ddd;
  }

  /* Typography Base */
  .hf-title {
    font-size: 42px;
    line-height: 0.95;
    text-transform: uppercase;
    font-weight: 800;
    margin: 0 0 15px 0;
    color: var(--hf-text-color);
  }

  .hf-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .hf-icon-pin {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .hf-eyebrow-text {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .hf-main-image-wrap {
    width: 100%;
    height: 390px;
    border-radius: 8px;
    overflow: hidden;
  }

  .hf-right-col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Mobile Layout Adaptations */
  .hf-circle {
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
  }

  .hf-circle-top {
    width: 300px;
    height: 300px;
    z-index: 10;
  }

  .hf-circle-bottom {
    width: 226px;
    height: 226px;
    border: 8px solid var(--hf-bg-color);
    z-index: 30;
    margin-top: -60px;
    margin-left: 50px;
  }

  .hf-connector {
    display: none; /* Hide complex connector on mobile */
  }

  .hf-story {
    margin-top: 40px;
    width: 100%;
    text-align: left;
  }

  .hf-story-title {
    font-size: 32px;
    line-height: 0.96;
    text-transform: uppercase;
    font-weight: 800;
    margin: 0 0 15px 0;
  }

  .hf-story-text p {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 20px 0;
  }

  .hf-cta {
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--hf-text-color);
    transition: color 0.3s ease;
  }

  .hf-cta:hover {
    color: var(--hf-primary-color);
  }


  /* DESKTOP STYLES (Match Reference Image 1-1) */
  @media (min-width: 1024px) {
    .hollow-fiber-section {
      padding: 90px 50px;
    }

    .hf-background-logo {
      top: 0;
      right: 0;
      width: 230px;
      transform: none;
    }

    .hf-layout {
      flex-direction: row;
      align-items: stretch;
      justify-content: space-between;
      gap: 0;
    }

    .hf-left-col {
      width: 45%;
      max-width: 544px;
      padding-top: 20px;
    }

    .hf-right-col {
      width: 53%;
      display: block;
    }

    /* Overlapping Image Heading */
    .hf-heading-stack {
      position: relative;
      z-index: 20;
      max-width: 410px;
      margin-left: 50px;
      margin-bottom: -67px; /* Pulls image up underneath heading */
    }

    .hf-title {
      font-size: 72px;
    }

    .hf-main-image-wrap {
      height: 530px;
    }

    /* Floating Desktop Circles */
    .hf-circle {
      position: absolute;
    }

    .hf-circle-top {
      top: 0;
      right: 0%;
      width: 450px;
      height: 450px;
    }

    .hf-circle-bottom {
      top: 300px;
      right: 20px;
      width: 320px;
      height: 320px;
      border-width: 12px;
      margin: 0;
    }

    /* Specific Desktop Connector Line */
    .hf-connector {
      display: block;
      position: absolute;
      z-index: 31;
      top: 480px;
      right: 310px;
      width: 180px;
      height: 1px;
      background-color: var(--hf-primary-color);
    }

    .hf-connector::after {
      content: '';
      position: absolute;
      right: -3px;
      top: -3px;
      width: 7px;
      height: 7px;
      background: var(--hf-primary-color);
      border-radius: 50%;
    }

    /* Floating Story Text */
    .hf-story {
      position: absolute;
      bottom: -10px;
      left: 0;
      max-width: 250px;
      margin-top: 0;
    }

    .hf-story-title {
      font-size: 40px;
    }
  }

  @media (min-width: 1280px) {
    .hf-circle-top {
      width: 488px;
      height: 488px;
    }
    .hf-circle-bottom {
      width: 346px;
      height: 346px;
      right: 60px;
      top: 320px;
    }
    .hf-connector {
      top: 510px;
      right: 280px;
      width: 150px;
    }
  }
</style>

{% schema %}
{
  "name": "Hollow fiber story",
  "class": "hollow-story-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why Alpaca Fiber Outperforms Wool and Cotton" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ethically sourced in the high altitudes of peru" },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "image_picker", "id": "circle_1", "label": "Top circle image" },
    { "type": "image_picker", "id": "circle_2", "label": "Bottom circle image" },
    { "type": "text", "id": "story_title", "label": "Story heading", "default": "hollow by nature" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Unlike cotton and wool, alpaca fiber is naturally hollow, creating breathable warmth and dry comfort without bulk." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hollow fiber story" }],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}