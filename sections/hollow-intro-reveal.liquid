<section class="hollow-intro" data-section-id="{{ section.id }}">
  <div class="page-width hollow-intro__desktop">
    <div class="hollow-intro__grid">
      <div class="hollow-intro__left">
        {%- if section.settings.left_heading != blank -%}
          <h2 class="hollow-intro__heading">{{ section.settings.left_heading }}</h2>
        {%- endif -%}
        <ul class="hollow-intro__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="hollow-intro__feature" {{ block.shopify_attributes }}>
                <span class="hollow-intro__icon">{%- render 'hollow-icon', name: block.settings.icon -%}</span>
                <span class="hollow-intro__feature-text">{{ block.settings.label }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="hollow-intro__center">
        {%- if section.settings.center_image != blank -%}
          {{ section.settings.center_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'hollow-intro__fiber-image', widths: '480, 720, 900, 1200' }}
        {%- else -%}
          <div class="hollow-intro__fiber-fallback" aria-hidden="true"></div>
        {%- endif -%}
      </div>

      <div class="hollow-intro__right">
        {%- if section.settings.right_heading != blank -%}
          <h2 class="hollow-intro__heading hollow-intro__heading--right">{{ section.settings.right_heading }}</h2>
        {%- endif -%}
        <div class="hollow-intro__activities">
          {%- for block in section.blocks -%}
            {%- if block.type == 'activity' -%}
              <a class="hollow-intro__activity" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="hollow-intro__activity-media">
                  {%- if block.settings.badge != blank -%}
                    <span class="hollow-intro__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '320, 480, 720' }}
                  {%- endif -%}
                </span>
                <span class="hollow-intro__activity-title">{{ block.settings.title }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="hollow-intro__mobile">
    {%- if section.settings.right_heading != blank -%}
      <h2 class="hollow-intro__heading">{{ section.settings.right_heading }}</h2>
    {%- endif -%}
    <div class="hollow-intro__mobile-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'activity' -%}
          <a class="hollow-intro__activity" href="{{ block.settings.link | default: '#' }}">
            <span class="hollow-intro__activity-media">
              {%- if block.settings.badge != blank -%}
                <span class="hollow-intro__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </span>
            <span class="hollow-intro__activity-title">{{ block.settings.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.left_heading != blank -%}
      <h2 class="hollow-intro__heading">{{ section.settings.left_heading }}</h2>
    {%- endif -%}
    <ul class="hollow-intro__features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <li class="hollow-intro__feature">
            <span class="hollow-intro__icon">{%- render 'hollow-icon', name: block.settings.icon -%}</span>
            <span class="hollow-intro__feature-text">{{ block.settings.label }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hollow intro reveal",
  "class": "hollow-intro-section",
  "settings": [
    {
      "type": "textarea",
      "id": "left_heading",
      "label": "Left heading",
      "default": "HOLLOW SOCKS ARE MADE WITH ALPACA FIBER."
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right heading",
      "default": "shop by activity"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "temp",
          "options": [
            { "value": "temp", "label": "Temperature" },
            { "value": "air", "label": "Breathable" },
            { "value": "fiber", "label": "Alpaca fiber" },
            { "value": "drop", "label": "Moisture" },
            { "value": "shield", "label": "Odor" },
            { "value": "usa", "label": "Made in USA" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Temperature Regulating" }
      ]
    },
    {
      "type": "activity",
      "name": "Activity",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "compression" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "badge", "label": "Badge" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow intro reveal",
      "blocks": [
        { "type": "feature", "settings": { "icon": "temp", "label": "Temperature Regulating" } },
        { "type": "feature", "settings": { "icon": "air", "label": "Breathable & Light" } },
        { "type": "feature", "settings": { "icon": "fiber", "label": "Soft Alpaca Fiber" } },
        { "type": "feature", "settings": { "icon": "drop", "label": "Moisture Wicking" } },
        { "type": "feature", "settings": { "icon": "shield", "label": "Odor Resistant" } },
        { "type": "activity", "settings": { "title": "compression" } },
        { "type": "activity", "settings": { "title": "trades" } },
        { "type": "activity", "settings": { "title": "bundles", "badge": "50% OFF" } },
        { "type": "activity", "settings": { "title": "hunting" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
