{%- style -%}
  .custom-marquee-{{ section.id }} {
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: {{ section.settings.padding_y }}px 0;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--font-body-family), sans-serif;
  }

  .marquee-track-{{ section.id }} {
    display: flex;
    white-space: nowrap;
    animation: scrollMarquee {{ section.settings.speed }}s linear infinite;
  }

  /* Pause on hover if desired */
  .custom-marquee-{{ section.id }}:hover .marquee-track-{{ section.id }} {
    animation-play-state: paused;
  }

  .marquee-content-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-width: 100%;
    flex-shrink: 0;
  }

  .marquee-item-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 40px; /* Space between each item */
    font-size: {{ section.settings.font_size }}px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .marquee-item-{{ section.id }} img {
    width: {{ section.settings.icon_size }}px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  @keyframes scrollMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @media screen and (max-width: 768px) {
    .marquee-item-{{ section.id }} {
      padding: 0 25px;
      font-size: {{ section.settings.font_size | minus: 2 }}px;
    }
  }
{%- endstyle -%}

<div class="custom-marquee-{{ section.id }}">
  <div class="marquee-track-{{ section.id }}">
    {%- comment -%} 
      We loop the content 3 times to ensure a smooth, seamless infinite scroll 
      regardless of screen size.
    {%- endcomment -%}
    {%- for i in (1..3) -%}
      <div class="marquee-content-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="marquee-item-{{ section.id }}" {{ block.shopify_attributes }}>
            
            {%- comment -%} Prefer Shopify Image Picker, fallback to the external URL {%- endcomment -%}
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy' }}
            {%- elsif block.settings.icon_url != blank -%}
              <img src="{{ block.settings.icon_url }}" alt="{{ block.settings.text | escape }}" loading="eager">
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
            
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E4DCD0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30,
      "info": "Lower is faster."
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
