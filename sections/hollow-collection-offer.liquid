<div class="hollow-collection-offer" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="hollow-collection-offer__inner">
      {%- if section.settings.badge != blank -%}
        <p class="hollow-collection-offer__badge">{{ section.settings.badge }}</p>
      {%- endif -%}

      {%- if section.settings.headline != blank -%}
        <h2 class="hollow-collection-offer__headline">{{ section.settings.headline }}</h2>
      {%- endif -%}

      <p class="hollow-collection-offer__subline">
        {%- if section.settings.compare_price != blank -%}
          <s class="hollow-collection-offer__compare">{{ section.settings.compare_price }}</s>
        {%- endif -%}
        {%- if section.settings.compare_price != blank and section.settings.subline != blank -%}
          <span class="hollow-collection-offer__sep" aria-hidden="true">·</span>
        {%- endif -%}
        {%- if section.settings.subline != blank -%}
          <span>{{ section.settings.subline }}</span>
        {%- endif -%}
      </p>

      {%- if section.blocks.size > 0 -%}
        <ol class="hollow-collection-offer__steps">
          {%- for block in section.blocks -%}
            <li class="hollow-collection-offer__step" {{ block.shopify_attributes }}>
              <span class="hollow-collection-offer__step-num">{{ forloop.index }}</span>
              <span class="hollow-collection-offer__step-text">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <p class="hollow-collection-offer__trust">
          <span class="hollow-collection-offer__stars" aria-label="5 ud af 5 stjerner">★★★★★</span>
          “{{ section.settings.quote }}”
          {%- if section.settings.quote_author != blank %} – {{ section.settings.quote_author }}{% endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.trust != blank -%}
        <p class="hollow-collection-offer__trust hollow-collection-offer__trust--meta">
          {%- assign trust_parts = section.settings.trust | split: ' · ' -%}
          {%- for part in trust_parts -%}
            <span class="hollow-collection-offer__nowrap">{{ part | strip }}</span>
            {%- unless forloop.last %} · {% endunless -%}
          {%- endfor -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Strikkestuen offer header",
  "class": "hollow-collection-offer-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "EFTERÅRSTILBUD"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "KØB 2 – FÅ 2 GRATIS"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Strikethrough price",
      "default": "1.196 kr."
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "150 kr. pr. par · Fri fragt"
    },
    {
      "type": "header",
      "content": "Review line (below steps)"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "Hælen ser ud som dagen jeg fik dem"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author",
      "default": "Inger"
    },
    {
      "type": "text",
      "id": "trust",
      "label": "Trust text",
      "default": "12 mdr. garanti · Ingen spørgsmål"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Vælg 4 par"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strikkestuen offer header",
      "blocks": [
        { "type": "step", "settings": { "text": "Vælg 4 par" } },
        { "type": "step", "settings": { "text": "Læg dem i kurven" } },
        { "type": "step", "settings": { "text": "2 par trækkes fra automatisk" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
