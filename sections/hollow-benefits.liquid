<section class="hollow-benefits" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-benefits__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="hollow-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="hollow-benefits__item" {{ block.shopify_attributes }}>
          <div class="hollow-benefits__icon">
            {%- case block.settings.icon -%}
              {%- when 'temp' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M24 8v18m0 0a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm-3-14h6M21 16h6M21 20h6"/><rect x="20" y="6" width="8" height="22" rx="4"/></svg>
              {%- when 'air' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 18h22a5 5 0 1 0-4-8M8 26h28a5 5 0 1 1-4 8M12 34h18"/></svg>
              {%- when 'fiber' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="24" cy="24" r="10"/><circle cx="24" cy="24" r="4"/><path d="M24 4v8M24 36v8M4 24h8M36 24h8M9 9l6 6M33 33l6 6M39 9l-6 6M15 33l-6 6"/></svg>
              {%- when 'drop' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M24 8c8 10 12 16 12 22a12 12 0 0 1-24 0c0-6 4-12 12-22Z"/><path d="M20 28c1 4 4 6 8 6"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M24 8 38 14v12c0 8-6 14-14 16-8-2-14-8-14-16V14L24 8Z"/><path d="m18 25 4 4 8-10"/></svg>
              {%- when 'usa' -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="8" y="12" width="32" height="24" rx="2"/><path d="M8 20h32M8 28h32M18 12v24"/></svg>
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="24" cy="24" r="10"/></svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.label != blank -%}
            <div class="hollow-benefits__label">{{ block.settings.label }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow benefits",
  "class": "hollow-benefits-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOLLOW SOCKS ARE MADE WITH ALPACA FIBER."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "fiber",
          "options": [
            { "value": "temp", "label": "Temperature" },
            { "value": "air", "label": "Breathable" },
            { "value": "fiber", "label": "Fiber" },
            { "value": "drop", "label": "Moisture" },
            { "value": "shield", "label": "Odor / shield" },
            { "value": "usa", "label": "Made in USA" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Soft Alpaca Fiber"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "temp", "label": "Temperature Regulating" } },
        { "type": "benefit", "settings": { "icon": "air", "label": "Breathable & Light" } },
        { "type": "benefit", "settings": { "icon": "fiber", "label": "Soft Alpaca Fiber" } },
        { "type": "benefit", "settings": { "icon": "drop", "label": "Moisture Wicking" } },
        { "type": "benefit", "settings": { "icon": "shield", "label": "Odor Resistant" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
