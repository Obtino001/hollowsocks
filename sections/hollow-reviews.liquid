<section id="hollow-reviews-section" class="hollow-reviews" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-reviews__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="hollow-reviews__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <blockquote class="hollow-reviews__card" {{ block.shopify_attributes }}>
            <p class="hollow-reviews__quote">{{ block.settings.quote }}</p>
            {%- if block.settings.author != blank -%}
              <cite class="hollow-reviews__author">{{ block.settings.author }}</cite>
            {%- endif -%}
            {%- if block.settings.meta != blank -%}
              <div class="hollow-reviews__meta">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                {{ block.settings.meta }}
              </div>
            {%- endif -%}
          </blockquote>
        {%- elsif block.type == 'image' -%}
          <figure class="hollow-reviews__photo{% if block.settings.tall %} is-tall{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480, 720, 900' }}
            {%- else -%}
              <div class="hollow-reviews__photo-fallback" aria-hidden="true"></div>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a class="hollow-btn hollow-btn--dark" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Strikkestuen reviews",
  "class": "hollow-reviews-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "OVER 4,000,000+ PAIRS SOLD" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "READ MORE REVIEWS —" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I’m very happy with this purchase, they are a quality product." },
        { "type": "text", "id": "author", "label": "Author", "default": "Steve J" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "verified buyer" }
      ]
    },
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "tall", "label": "Tall crop", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strikkestuen reviews",
      "blocks": [
        { "type": "image" },
        { "type": "review" },
        { "type": "review" },
        { "type": "image" },
        { "type": "image" },
        { "type": "review" },
        { "type": "review" },
        { "type": "image" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}
