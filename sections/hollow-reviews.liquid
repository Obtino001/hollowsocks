<section id="hollow-reviews-section" class="hollow-reviews" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-reviews__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="hollow-reviews__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <blockquote class="hollow-reviews__card" {{ block.shopify_attributes }}>
            <div class="hollow-reviews__stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </div>
            <p class="hollow-reviews__quote">{{ block.settings.quote }}</p>
            <cite class="hollow-reviews__author">{{ block.settings.author }}</cite>
            <div class="hollow-reviews__meta">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              {{ block.settings.meta }}
            </div>
          </blockquote>
        {%- elsif block.type == 'image' -%}
          <figure class="hollow-reviews__photo{% if block.settings.tall %} is-tall{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480, 720, 900' }}
            {%- else -%}
              <div class="hollow-reviews__photo-fallback" aria-hidden="true"></div>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a class="hollow-btn hollow-btn--dark" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Strikkestuen reviews",
  "class": "hollow-reviews-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "OVER 4,000,000+ PAIRS SOLD" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "READ MORE REVIEWS —" },
    { "type": "url", "id": "button_link", "label": "Button link" },
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I’m very happy with this purchase, they are a quality product." },
        { "type": "text", "id": "author", "label": "Author", "default": "Steve J" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "verified buyer" }
      ]
    },
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "tall", "label": "Tall crop", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strikkestuen reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "I’m very happy with this purchase, they are a quality product. They feel great and are very comfortable. Just what I needed for long walks with my dog. Highly recommend them to anyone who is looking for a great pair of socks.", "author": "Steve J", "meta": "verified buyer" } },
        { "type": "review", "settings": { "quote": "I was looking for an ankle size compression sock that was comfortable and was a good compression that was easy to put on my feet. I gave it 5 stars because even in the hot weather they feel very comfortable!", "author": "Michael W", "meta": "verified buyer" } },
        { "type": "review", "settings": { "quote": "These compression socks are FANTASTIC. I have been wearing compression stocking for 10 years and this is the first time I am not taking them off as soon as possible. My legs feel 30 years younger and I am not in pain.", "author": "drew s", "meta": "verified buyer" } },
        { "type": "review", "settings": { "quote": "After years of struggling with sweaty, blistered feet through countless sock types, these game-changing alpaca socks finally work.", "author": "Raymond L.", "meta": "verified buyer" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.popups"]
  }
}
{% endschema %}
