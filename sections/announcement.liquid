<style>
  {%- if settings.color_announcement == settings.color_body_bg -%}
    .announcement-bar {
      border-bottom: 1px solid;
    }
  {%- endif -%}
</style>

{%- render 'announcement-bar', section: section -%}

{% schema %}
{
  "name": "t:sections.header.settings.header_announcement_bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "announcement_compact",
      "label": "t:sections.header.settings.announcement_compact.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_on_scroll",
      "label": "t:sections.header.settings.announcement_sticky_on_scroll.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_on_mobile",
      "label": "t:sections.header.settings.announcement_sticky_on_mobile.label",
      "default": false,
      "visible_if": "{{ section.settings.sticky_on_scroll == true }}"
    },
    {
      "type": "header",
      "content": "Hollow promo bar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LABOR DAY SALE"
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer text",
      "default": "BUY 2 GET 2 FREE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Countdown end (ISO)",
      "info": "Example: 2026-09-07T23:59:59",
      "default": "2026-08-20T23:59:59"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "announcement",
      "name": "t:sections.header.blocks.announcement.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.header.blocks.announcement.settings.text.label",
          "default": "Easy returns"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.header.blocks.announcement.settings.link_text.label",
          "default": "30-day returns on all orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "settings": {}
  },
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}

