<div class="hollow-collection-nav" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="hollow-collection-nav__row">
      {%- for block in section.blocks -%}
        {%- assign link_url = block.settings.link -%}
        {%- assign is_active = false -%}
        {%- if link_url != blank and request.path == link_url -%}
          {%- assign is_active = true -%}
        {%- elsif link_url != blank and collection.url == link_url -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        <a
          href="{{ link_url | default: '#' }}"
          class="hollow-collection-nav__item{% if is_active %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="hollow-collection-nav__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160,240,320' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="hollow-collection-nav__label">{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hollow collection nav",
  "class": "hollow-collection-nav-section",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "BEST SELLERS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow collection nav",
      "blocks": [
        { "type": "category", "settings": { "title": "BEST SELLERS" } },
        { "type": "category", "settings": { "title": "COMPRESSION" } },
        { "type": "category", "settings": { "title": "BUNDLES" } },
        { "type": "category", "settings": { "title": "TRADES" } },
        { "type": "category", "settings": { "title": "HUNTING" } },
        { "type": "category", "settings": { "title": "EVERYDAY" } },
        { "type": "category", "settings": { "title": "RUNNING" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
