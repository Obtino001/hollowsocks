<section class="hollow-banners" data-section-id="{{ section.id }}">
  {%- for block in section.blocks -%}
    <article class="hollow-banners__item" {{ block.shopify_attributes }}>
      <a class="hollow-banners__media" href="{{ block.settings.link | default: '#' }}">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '720, 1080, 1400, 1800' }}
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="hollow-banners__title">{{ block.settings.title }}</h3>
        {%- endif -%}
      </a>
      {%- if block.settings.text != blank -%}
        <p class="hollow-banners__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Hollow category banners",
  "class": "hollow-banners-section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Compression" },
        { "type": "textarea", "id": "text", "label": "Caption", "default": "The perfect aid for enhanced circulation and improved comfort." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow category banners",
      "blocks": [
        { "type": "banner", "settings": { "title": "Compression", "text": "The perfect aid for enhanced circulation and improved comfort." } },
        { "type": "banner", "settings": { "title": "trades", "text": "Socks built for the 14-hour long days on the worksite." } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
