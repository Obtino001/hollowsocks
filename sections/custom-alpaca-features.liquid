{% style %}
  .custom-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .custom-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media screen and (min-width: 769px) {
    .custom-grid-{{ section.id }} {
      grid-template-columns: minmax(0, 1.05fr) minmax(240px, 300px) minmax(0, 1.1fr);
      gap: 48px 56px;
    }
  }

  .left-col-heading-{{ section.id }} {
    font-family: var(--hollow-display) !important;
    font-size: clamp(36px, 4.6vw, 56px);
    text-transform: uppercase;
    font-weight: 700;
    line-height: 0.95;
    
    margin: 0 0 32px;
    max-width: 12ch;
    color: #1a1a1a;
  }

  .feature-list-{{ section.id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 360px;
    border-top: 1px solid #1a1a1a;
  }

  .feature-item-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #1a1a1a;
  }

  .feature-icon-{{ section.id }} {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    object-fit: contain;
    color: #1a1a1a;
  }

  .feature-icon-{{ section.id }} svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .feature-text-{{ section.id }} {
    font-family: var(--hollow-mono) !important;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .center-col-image-wrapper-{{ section.id }} {
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    border-radius: 10px;
    overflow: hidden;
  }

  .center-col-image-wrapper-{{ section.id }} img {
    width: 100%;
    aspect-ratio: 3 / 4.2;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .right-col-heading-{{ section.id }} {
    font-family: var(--hollow-display) !important;
    font-size: clamp(26px, 2.8vw, 36px);
    text-transform: uppercase;
    font-weight: 700;
    
    line-height: 1;
    margin: 0 0 22px;
    color: #1a1a1a;
  }

  .activity-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
  }

  .activity-card-{{ section.id }} {
    text-decoration: none;
    display: block;
    color: #1a1a1a;
  }

  .activity-image-wrapper-{{ section.id }} {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #d9d4cc;
  }

  .activity-image-wrapper-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .activity-badge-{{ section.id }} {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1;
    background: #ebe6dc;
    color: #1a1a1a;
    font-family: var(--hollow-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 4px 8px;
    text-transform: uppercase;
    border-radius: 2px;
    line-height: 1.2;
  }

  .activity-title-{{ section.id }} {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-family: var(--hollow-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1a1a1a;
  }
{% endstyle %}

<div class="custom-section-{{ section.id }}">
  <div class="page-width">
    <div class="custom-grid-{{ section.id }}">

      <div class="grid-column left-column">
        {% if section.settings.left_heading != blank %}
          <h2 class="left-col-heading-{{ section.id }}">{{ section.settings.left_heading | newline_to_br }}</h2>
        {% endif %}

        <ul class="feature-list-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'feature_item' %}
              <li class="feature-item-{{ section.id }}" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  {% capture icon_class %}feature-icon-{{ section.id }}{% endcapture %}
                  {{ block.settings.icon | image_url: width: 50 | image_tag: class: icon_class, loading: 'lazy' }}
                {% elsif block.settings.icon_key != blank %}
                  <span class="feature-icon-{{ section.id }}">{%- render 'hollow-icon', icon: block.settings.icon_key -%}</span>
                {% endif %}
                <span class="feature-text-{{ section.id }}">{{ block.settings.title }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="grid-column center-column">
        <div class="center-col-image-wrapper-{{ section.id }}">
          {% if section.settings.center_image != blank %}
            {{ section.settings.center_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      <div class="grid-column right-column">
        {% if section.settings.right_heading != blank %}
          <h2 class="right-col-heading-{{ section.id }}">{{ section.settings.right_heading }}</h2>
        {% endif %}

        <div class="activity-grid-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'activity_card' %}
              <a href="{{ block.settings.link | default: '#' }}" class="activity-card-{{ section.id }}" {{ block.shopify_attributes }}>
                <div class="activity-image-wrapper-{{ section.id }}">
                  {% if block.settings.badge_text != blank %}
                    <span class="activity-badge-{{ section.id }}">{{ block.settings.badge_text }}</span>
                  {% endif %}

                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <span class="activity-title-{{ section.id }}">{{ block.settings.title }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "3-Column Features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f6f2"
    },
    {
      "type": "textarea",
      "id": "left_heading",
      "label": "Left Column Heading",
      "default": "HOLLOW SOCKS ARE MADE WITH ALPACA FIBER."
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Main Image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right Column Heading",
      "default": "SHOP BY ACTIVITY"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Left Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon image (optional)"
        },
        {
          "type": "select",
          "id": "icon_key",
          "label": "Built-in icon",
          "default": "temp",
          "options": [
            { "value": "temp", "label": "Temperature" },
            { "value": "air", "label": "Breathable" },
            { "value": "fiber", "label": "Alpaca fiber" },
            { "value": "drop", "label": "Moisture" },
            { "value": "shield", "label": "Odor" },
            { "value": "usa", "label": "Made in USA" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Text",
          "default": "TEMPERATURE REGULATING"
        }
      ]
    },
    {
      "type": "activity_card",
      "name": "Right Activity Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Activity Name",
          "default": "COMPRESSION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (Optional)",
          "info": "e.g., '50% OFF'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3-Column Features (Custom)",
      "blocks": [
        { "type": "feature_item", "settings": { "icon_key": "temp", "title": "TEMPERATURE REGULATING" } },
        { "type": "feature_item", "settings": { "icon_key": "air", "title": "BREATHABLE & LIGHT" } },
        { "type": "feature_item", "settings": { "icon_key": "fiber", "title": "SOFT ALPACA FIBER" } },
        { "type": "feature_item", "settings": { "icon_key": "drop", "title": "MOISTURE WICKING" } },
        { "type": "feature_item", "settings": { "icon_key": "shield", "title": "ODOR RESISTANT" } },
        { "type": "activity_card", "settings": { "title": "COMPRESSION" } },
        { "type": "activity_card", "settings": { "title": "TRADES" } },
        { "type": "activity_card", "settings": { "title": "BUNDLES", "badge_text": "50% OFF" } },
        { "type": "activity_card", "settings": { "title": "HUNTING" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
