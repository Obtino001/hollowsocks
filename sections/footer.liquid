
<style>
  .custom-footer {
    background-color: #282828;
    color: #F6F5F0;
    padding: 60px 0 40px;
    font-family: var(--font-body-family), sans-serif;
  }
  .custom-footer a {
    color: #F6F5F0;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .custom-footer a:hover {
    opacity: 0.7;
  }

  .custom-footer__top {
    display: flex;
    {% comment %} flex-wrap: wrap;/ {% endcomment %}
    gap: 60px;
    margin-bottom: 80px;
  }

  /* Newsletter Box (Left) */
  .custom-footer__newsletter {
    flex: 0 0 32%;
    background-color: #444;
    background-size: cover;
    background-position: center;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    min-height: 450px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  /* Overlay gradient to make text readable */
  .custom-footer__newsletter::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
    z-index: 1;
  }
  .custom-footer__newsletter-content {
    position: relative;
    z-index: 2;
    padding: 40px;
  }
  .custom-footer__newsletter h3 {
    margin: 0 0 10px;
    font-size: 28px;
    font-weight: 800;
    text-transform: uppercase;
    color: #F6F5F0;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }
  .custom-footer__newsletter p {
    margin: 0 0 20px;
    font-size: 14px;
    color: #F6F5F0;
    opacity: 0.9;
  }
  .custom-footer__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .custom-footer__form-inner {
    display: flex;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
  }
  .custom-footer__form-inner input {
    flex: 1;
    border: none;
    padding: 15px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #000;
    background: transparent;
    outline: none;
  }
  .custom-footer__form-inner input::placeholder {
    color: #555;
  }
  .custom-footer__form-inner button {
    background: transparent;
    border: none;
    padding: 0 20px;
    cursor: pointer;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .custom-footer__disclaimer {
    margin-top: 15px;
    font-size: 11px;
    color: #ccc;
  }
  .custom-footer__disclaimer a {
    text-decoration: underline;
    color: #F6F5F0;
  }

  /* Menus & Brand (Right) */
  .custom-footer__right {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .custom-footer__brand {
    font-size: 9vw;
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
    color: #F6F5F0;
    margin-bottom: 50px;
    letter-spacing: -2px;
    margin-top: -2vw; /* Pull up slightly to align top edge with image */
  }
  
  /* Hardcode max size for giant screens */
  @media (min-width: 1440px) {
    .custom-footer__brand {
      font-size: 130px;
      margin-top: -30px;
    }
  }

  .custom-footer__menus {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    justify-content: space-between;
    max-width: 800px;
  }
  .custom-footer__menu {
    flex: 1;
    min-width: 150px;
  }
  .custom-footer__menu h4 {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #F6F5F0;
    opacity: 0.7;
  }
  .custom-footer__menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .custom-footer__menu ul a {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Bottom Bar */
  .custom-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(246, 245, 240, 0.1);
    padding-top: 30px;
    flex-wrap: wrap;
    gap: 20px;
  }
  .custom-footer__bottom-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .custom-footer__bottom-left span.divider {
    opacity: 0.5;
  }
  
  .custom-footer__bottom-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .custom-footer__bottom-right > span {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .custom-footer__social {
    display: flex;
    gap: 15px;
  }
  .custom-footer__social .list-social__item {
    margin: 0;
  }
  .custom-footer__social .list-social__link {
    padding: 0;
    color: #F6F5F0;
  }
  .custom-footer__social svg {
    width: 18px;
    height: 18px;
  }

  /* Responsive */
  @media (max-width: 990px) {
    .custom-footer__top {
      flex-direction: column;
      flex-wrap: wrap;
      gap: 40px;
    }
    .custom-footer__newsletter {
      width: 100%;
      min-height: 400px;
    }
    .custom-footer__brand {
      font-size: 12vw;
      margin-top: 0;
      margin-bottom: 30px;
    }
    .custom-footer__menus {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .custom-footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .custom-footer__newsletter-content {
      text-align: center;
    }
    .custom-footer__brand {
      text-align: center;
    }
  }
</style>

<footer class="custom-footer">
  <div class="page-width">
  <div class="custom-footer__top">
    <!-- Left: Newsletter Block -->
    {%- assign bg_image_url = 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png' -%}
    {%- if section.settings.newsletter_image != blank -%}
      {%- assign bg_image_url = section.settings.newsletter_image | image_url: width: 1000 -%}
    {%- endif -%}
    
    <div class="custom-footer__newsletter" style="background-image: url('{{ bg_image_url }}');">
      <div class="custom-footer__newsletter-content">
        <h3>{{ section.settings.newsletter_heading }}</h3>
        <p>{{ section.settings.newsletter_subheading }}</p>
        
        {% form 'customer', class: 'custom-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="custom-footer__form-inner">
            <input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required>
            <button type="submit" aria-label="Subscribe">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        {% endform %}
        
        <div class="custom-footer__disclaimer">{{ section.settings.newsletter_disclaimer }}</div>
      </div>
    </div>
    
    <!-- Right: Brand + Menus -->
    <div class="custom-footer__right">
      <div class="custom-footer__brand">{{ section.settings.brand_text }}</div>
      <div class="custom-footer__menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="custom-footer__menu">
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.menu != blank -%}
                <ul>
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  
  <div class="custom-footer__bottom">
    <div class="custom-footer__bottom-left">
      <span>&copy;{{ section.settings.brand_text }} {{ 'now' | date: '%Y' }}</span>
      {%- for policy in shop.policies -%}
        <span class="divider">&middot;</span> <a href="{{ policy.url }}">{{ policy.title }}</a>
      {%- endfor -%}
    </div>
    <div class="custom-footer__bottom-right">
      <span>FOLLOW ALONG</span>
      <div class="custom-footer__social">
        {%- render 'social-icons', class: 'list-social' -%}
      </div>
    </div>
  </div>
</div>
</footer>

{% schema %}
{
  "name": "Custom Footer 1:1",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Box"
    },
    {
      "type": "image_picker",
      "id": "newsletter_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "JOIN THE ARVENIXO CREW"
    },
    {
      "type": "text",
      "id": "newsletter_subheading",
      "label": "Subheading",
      "default": "Stay connected for new releases and exclusive offers."
    },
    {
      "type": "richtext",
      "id": "newsletter_disclaimer",
      "label": "Disclaimer text",
      "default": "<p>You can unsubscribe at any time. <a href=\"#\">View Terms & Privacy</a>.</p>"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Massive Brand Text",
      "default": "ARVENIXO"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom Utility Menu (Policies)"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer 1:1",
      "blocks": [
        {
          "type": "link_list"
        },
        {
          "type": "link_list"
        },
        {
          "type": "link_list"
        }
      ]
    }
  ]
}
{% endschema %}
