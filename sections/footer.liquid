{%- liquid
  assign bg_image_url = blank
  if section.settings.newsletter_image != blank
    assign bg_image_url = section.settings.newsletter_image | image_url: width: 1200
  endif
-%}

<footer class="custom-footer" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="custom-footer__top">
      <div
        class="custom-footer__newsletter{% if bg_image_url == blank %} custom-footer__newsletter--empty{% endif %}"
        {% if bg_image_url != blank %}style="background-image: url('{{ bg_image_url }}');"{% endif %}
      >
        <div class="custom-footer__newsletter-content">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="custom-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_subheading != blank -%}
            <p class="custom-footer__newsletter-sub">{{ section.settings.newsletter_subheading }}</p>
          {%- endif -%}

          {% form 'customer', class: 'custom-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="custom-footer__form-inner">
              <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
              <input
                id="FooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                placeholder="Din e-mail"
                autocomplete="email"
                required
              >
              <button type="submit" aria-label="Subscribe">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          {% endform %}

          {%- if section.settings.newsletter_disclaimer != blank -%}
            <div class="custom-footer__disclaimer">{{ section.settings.newsletter_disclaimer }}</div>
          {%- endif -%}
        </div>
      </div>

      <div class="custom-footer__right">
        <div class="custom-footer__brand" aria-label="{{ section.settings.brand_text | default: 'Strikkestuen' | escape }}">
          <span class="custom-footer__brand-text">{{ section.settings.brand_text | default: 'STRIKKESTUEN' | escape }}</span>
        </div>

        <div class="custom-footer__menus">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link_list' -%}
              <nav class="custom-footer__menu" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
                {%- if block.settings.heading != blank -%}
                  <h3 class="custom-footer__menu-title">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul>
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="custom-footer__bottom">
      <div class="custom-footer__bottom-left">
        <span>&copy;{{ section.settings.brand_text | default: 'STRIKKESTUEN' | upcase }} {{ 'now' | date: '%Y' }}</span>
        {%- if section.settings.bottom_menu != blank -%}
          {%- for link in section.settings.bottom_menu.links -%}
            <span class="custom-footer__dot" aria-hidden="true">&middot;</span>
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <span class="custom-footer__dot" aria-hidden="true">&middot;</span>
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="custom-footer__bottom-right">

        <div class="custom-footer__social">
          {%- render 'social-icons', additional_classes: 'custom-footer__social-list' -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Strikkestuen footer",
  "class": "hollow-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter card"
    },
    {
      "type": "image_picker",
      "id": "newsletter_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "JOIN THE STRIKKESTUEN CREW"
    },
    {
      "type": "text",
      "id": "newsletter_subheading",
      "label": "Subheading",
      "default": "Stay connected for new releases and exclusive offers."
    },
    {
      "type": "richtext",
      "id": "newsletter_disclaimer",
      "label": "Disclaimer",
      "default": "<p>You can unsubscribe at any time. <a href=\"/policies/terms-of-service\">View Terms & Privacy</a>.</p>"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name (copyright)",
      "default": "STRIKKESTUEN"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Legal links menu"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SHOP"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strikkestuen footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "SHOP" } },
        { "type": "link_list", "settings": { "heading": "LEARN" } },
        { "type": "link_list", "settings": { "heading": "SUPPORT" } }
      ]
    }
  ]
}
{% endschema %}
