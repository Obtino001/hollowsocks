<section class="hollow-instagram" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-instagram__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.handle != blank -%}
      <a class="hollow-instagram__handle" href="{{ section.settings.handle_link }}">{{ section.settings.handle }}</a>
    {%- endif -%}
    <div class="hollow-instagram__grid">
      {%- for block in section.blocks -%}
        <a class="hollow-instagram__item" href="{{ block.settings.link | default: section.settings.handle_link }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- render 'image-element',
              img: block.settings.image,
              widths: '240, 360, 480, 720',
              loading: 'lazy'
            -%}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow Instagram",
  "class": "hollow-instagram-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Gear up for great days"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "#hollowsocks"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Handle link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
