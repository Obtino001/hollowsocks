<section class="hollow-social" data-section-id="{{ section.id }}">
  <div class="page-width hollow-social__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hollow-social__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="hollow-social__meta">
      {%- if section.settings.handle != blank -%}
        <a class="hollow-social__handle" href="{{ section.settings.handle_link | default: '#' }}">{{ section.settings.handle }}</a>
      {%- endif -%}
      {%- render 'social-icons' -%}
    </div>
  </div>
  <div class="hollow-social__track" data-hollow-marquee>
    <div class="hollow-social__row">
      {%- for block in section.blocks -%}
        <a class="hollow-social__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '320, 480, 720' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hollow social gallery",
  "class": "hollow-instagram-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Gear up for great days" },
    { "type": "text", "id": "handle", "label": "Hashtag", "default": "#hollowsocks" },
    { "type": "url", "id": "handle_link", "label": "Hashtag link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hollow social gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
